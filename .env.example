# Supabase Postgres connection string. Keep the real value server-side only.
DATABASE_URL=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres

# Public Supabase project config — safe to expose to the browser (NEXT_PUBLIC_*).
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder

# Checklist assistant (lib/ai/**). Server-side only — never expose to the browser.
ANTHROPIC_API_KEY=sk-ant-placeholder
# Optional override; defaults to claude-opus-5 (see lib/ai/model.ts). Model/
# provider choice is still under discussion — change here, not in code.
# ANTHROPIC_MODEL=claude-opus-5

