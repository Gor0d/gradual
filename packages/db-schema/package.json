{
  "name": "@gradual/db-schema",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./schema.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
    "db:seed": "node seed.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/pg": "8.15.2",
    "dotenv": "16.5.0",
    "drizzle-kit": "0.31.10",
    "typescript": "5.8.3"
  }
}
